# Tilt = live development for Kubernetes.
# `tilt up` builds the image, deploys it, and then every time you save a file
# in ./app it SYNCS the file into the running pods (no rebuild, no redeploy).
# UI: http://localhost:10350     App: http://localhost:8080

allow_k8s_contexts('kind-learn')

docker_build(
    'demo-app',                 # matches `image: demo-app:...` in the Deployment
    './app',
    target='dev',               # Dockerfile stage that runs `node --watch`
    live_update=[
        # Copy changed files straight into the container. `node --watch`
        # notices server.js changes and restarts; index.html is re-read per request.
        sync('./app', '/app'),
    ],
)

# Apply the same manifests you use by hand (HPA left out to keep dev simple).
k8s_yaml([
    'k8s/00-namespace.yaml',
    'k8s/10-configmap.yaml',
    'k8s/20-deployment.yaml',
    'k8s/30-service.yaml',
])

k8s_resource('demo', links=[link('http://localhost:8080', 'Live visualizer')])
